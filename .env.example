# Salin file ini menjadi `.env` lalu sesuaikan nilainya, atau export
# langsung sebagai environment variable di server/hosting Anda.
# (Proyek ini membaca env var langsung melalui os.environ; gunakan
# python-decouple / django-environ / direnv jika ingin memuat .env otomatis.)

DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Produksi (Docker di NAS), contoh:
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=10.101.21.55,localhost,127.0.0.1
#   DJANGO_CSRF_TRUSTED_ORIGINS=http://10.101.21.55:8000
# Origin (skema://host:port) yang boleh mengirim form, pisahkan dengan koma.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set True hanya bila diakses lewat reverse proxy HTTPS (mis. Reverse Proxy DSM).
DJANGO_BEHIND_HTTPS_PROXY=False

# ======================
# Docker / Gunicorn (hanya dipakai di container)
# ======================
DJANGO_MIGRATE_ON_START=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Seed otomatis saat container start (manage.py deploy_init).
# seed_demo_data hanya jalan di database baru (belum ada user);
# DJANGO_SEED_FORCE=True memaksa jalan ulang (idempoten).
DJANGO_INIT_ON_START=True
DJANGO_SEED_FORCE=False
DJANGO_SEED_PEGAWAI_ORG_UNITS=False
DJANGO_SEED_ADMIN_UNOR_ORG_UNITS=False
DJANGO_SEED_HARI_LIBUR=True
# Superuser /admin/ dibuat bila username belum ada (password tidak ditimpa).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

DB_NAME=paspor_db
DB_USER=paspor_user
DB_PASSWORD=paspor_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ======================
# S3 Bucket (Garage di Synology NAS)
# ======================
# Seluruh berkas unggahan disimpan di bucket ini lewat django-storages,
# lihat wiki/instructions/S3BUCKET_FILE_UPLOAD.MD.
# Buat key & bucket di Garage:
#   garage key create paspor-app
#   garage bucket create paspor-uploads
#   garage bucket allow --read --write --owner paspor-uploads --key paspor-app
S3_ACCESS_KEY=GKxxxxxxxxxxxxxxxxxxxxxxxx
S3_SECRET_KEY=ganti-dengan-secret-key-garage
S3_BUCKET_NAME=paspor-uploads
S3_ENDPOINT=http://10.101.21.55:3900
# Opsional (nilai default di settings.py):
S3_REGION_NAME=garage
# Masa berlaku presigned URL unduhan/pratinjau, dalam detik.
S3_QUERYSTRING_EXPIRE=3600

# ======================
# EMAIL
# ======================
MAIL_ALLOW_SEND=false
MAIL_DRIVER=smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Nama Aplikasi
MAIL_HOST=smtp.example.com
MAIL_PASSWORD=ganti-dengan-password-smtp
MAIL_PORT=587
MAIL_SITE_NAME=Nama Aplikasi
MAIL_USERNAME=noreply@example.com
MAIL_RETRY_ATTEMPTS=1
MAIL_RETRY_DELAY_MS=100
MAIL_TIMEOUT_MS=15000
MAIL_DB_QUEUE_ENABLE_WORKER=false
MAIL_DB_QUEUE_WORKER_INTERVAL_MS=15000
MAIL_DB_QUEUE_WORKER_BATCH_SIZE=20
MAIL_DB_QUEUE_MAX_ATTEMPTS=5
MAIL_DB_QUEUE_RETRY_DELAY_MS=30000
MAIL_DB_QUEUE_LOCK_TTL_MS=60000

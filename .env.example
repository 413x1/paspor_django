# Salin file ini menjadi `.env` lalu sesuaikan nilainya, atau export
# langsung sebagai environment variable di server/hosting Anda.
# (Proyek ini membaca env var langsung melalui os.environ; gunakan
# python-decouple / django-environ / direnv jika ingin memuat .env otomatis.)

DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=paspor_db
DB_USER=paspor_user
DB_PASSWORD=paspor_password
DB_HOST=127.0.0.1
DB_PORT=3306

# MinIO (object storage) — dipakai fitur unggah berkas, lihat wiki/UPLOAD_FILE.MD
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=nama-bucket-anda
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

# ======================
# EMAIL
# ======================
MAIL_ALLOW_SEND=false
MAIL_DRIVER=smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Nama Aplikasi
MAIL_HOST=smtp.example.com
MAIL_PASSWORD=ganti-dengan-password-smtp
MAIL_PORT=587
MAIL_SITE_NAME=Nama Aplikasi
MAIL_USERNAME=noreply@example.com
MAIL_RETRY_ATTEMPTS=1
MAIL_RETRY_DELAY_MS=100
MAIL_TIMEOUT_MS=15000
MAIL_DB_QUEUE_ENABLE_WORKER=false
MAIL_DB_QUEUE_WORKER_INTERVAL_MS=15000
MAIL_DB_QUEUE_WORKER_BATCH_SIZE=20
MAIL_DB_QUEUE_MAX_ATTEMPTS=5
MAIL_DB_QUEUE_RETRY_DELAY_MS=30000
MAIL_DB_QUEUE_LOCK_TTL_MS=60000
